        }
      }
    },
    "Publisher": {
      "Settings": {
        "IncomingEnabled": true,
        "AppId": "f682f3da-ed2e-405e-a18d-5abfed94f58f",
        "AppKey": "qeToziRhsK1xXWyaZSp5Ke25G/WwNOd31PzV1uEoiGE="
