{
  "$schema": "./appsettings-schema.json",
  "SGFDevs": {
    "EventSyncEnabled": false,
    "AzureBlobStorageKey": "",
    "NewsletterEndpoint": "",
    "NewsletterListId": "",
    "EventTimeZoneId": "America/Chicago",
    "Site": {
      "AnalyticsEnabled": false,
      "SearchIndexingEnabled": false
    },
    "Sessionize": {
      "BaseUrl": ""
    },
    "MeetupApi": {
      "BaseUrl": "",
      "ClientId": "",
      "ClientSecret": "",
      "GroupId": "sgfdevs"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Sentry": {
    "Dsn": "",
    "SendDefaultPii": true,
    "MaxRequestBodySize": "Always",
    "MinimumBreadcrumbLevel": "Debug",
    "MinimumEventLevel": "Warning",
    "AttachStackTrace": true,
    "Debug": true,
    "DiagnosticLevel": "Error"
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "eb41b267-4c02-43fd-b315-cee566710902",
        "UseHttps": false
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeManual"
      }
    }
  },
  "uSync": {
    "Sets": {
      "Default": {
        "Handlers": {
          "MediaHandler": {
            "Settings": {
              "Exclude": "/Members",
              "RulesOnExport": true
