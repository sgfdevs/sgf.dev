{
  "openapi": "3.1.1",
  "info": {
    "title": "SGF public API",
    "description": "Typed public endpoints for SGF frontend clients.",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:36395/"
    }
  ],
  "paths": {
    "/api/tags/skills": {
      "get": {
        "tags": [
          "DevsApi"
        ],
        "operationId": "Directory_GetSkillNames",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/directory/filters/skills": {
      "get": {
        "tags": [
          "DevsApi"
        ],
        "operationId": "Directory_GetSkillFilters",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicSkillFilterDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/directory/search": {
      "get": {
        "tags": [
          "DevsApi"
        ],
        "operationId": "Directory_Search",
        "parameters": [
          {
            "name": "skills",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "take",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicDirectoryMemberDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/home": {
      "get": {
        "tags": [
          "PublicHome"
        ],
        "operationId": "PublicHome_Get",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicHomeDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": { }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": { }
            }
          }
        }
      }
    },
    "/api/v1/public/members/{username}": {
      "get": {
        "tags": [
          "PublicMember"
        ],
        "operationId": "PublicMember_Get",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicMemberProfileDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PublicDirectoryMemberDto": {
        "required": [
          "name",
          "location",
          "image",
          "url",
          "tags"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PublicHomeDevNightDto": {
        "required": [
          "name",
          "startsAtLocal",
          "timeZone",
          "dateLabel",
          "dateTimeAttribute",
          "presentations"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "startsAtLocal": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "dateLabel": {
            "type": "string"
          },
          "dateTimeAttribute": {
            "type": "string"
          },
          "presentations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicHomePresentationDto"
            }
          }
        }
      },
      "PublicHomeDirectoryPreviewDto": {
        "required": [
          "totalMembers",
          "dailyMembers"
        ],
        "type": "object",
        "properties": {
          "totalMembers": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "dailyMembers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicDirectoryMemberDto"
            }
          }
        }
      },
      "PublicHomeDto": {
        "required": [
          "directory",
          "sponsors"
        ],
        "type": "object",
        "properties": {
          "nextDevNight": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PublicHomeDevNightDto"
              }
            ]
          },
          "directory": {
            "$ref": "#/components/schemas/PublicHomeDirectoryPreviewDto"
          },
          "sponsors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicHomeSponsorDto"
            }
          }
        }
      },
      "PublicHomeGroupDto": {
        "required": [
          "name",
          "path",
          "showAttribution"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "showAttribution": {
            "type": "boolean"
          }
        }
      },
      "PublicHomePresentationDto": {
        "required": [
          "title",
          "presenters"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "meetupUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "presenters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicHomePresenterDto"
            }
          },
          "group": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PublicHomeGroupDto"
              }
            ]
          }
        }
      },
      "PublicHomePresenterDto": {
        "required": [
          "name",
          "imageUrl",
          "tags"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "profilePath": {
            "type": [
              "null",
              "string"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PublicHomeSponsorDto": {
        "required": [
          "name",
          "path",
          "isFoundingSponsor"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "logoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "websiteUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "websiteLabel": {
            "type": [
              "null",
              "string"
            ]
          },
          "isFoundingSponsor": {
            "type": "boolean"
          }
        }
      },
      "PublicMemberProfileDto": {
        "required": [
          "username",
          "name",
          "profileImageUrl"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "firstName": {
            "type": [
              "null",
              "string"
            ]
          },
          "lastName": {
            "type": [
              "null",
              "string"
            ]
          },
          "jobTitle": {
            "type": [
              "null",
              "string"
            ]
          },
          "profileImageUrl": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "city": {
            "type": [
              "null",
              "string"
            ]
          },
          "state": {
            "type": [
              "null",
              "string"
            ]
          },
          "joinMonthLabel": {
            "type": [
              "null",
              "string"
            ]
          },
          "aboutHtml": {
            "type": [
              "null",
              "string"
            ]
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicMemberSkillDto"
            }
          },
          "websiteUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "websiteLabel": {
            "type": [
              "null",
              "string"
            ]
          },
          "twitterUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "linkedInUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "facebookUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "instagramUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "youTubeUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "availableForHire": {
            "type": "boolean"
          },
          "availableForContractWork": {
            "type": "boolean"
          }
        }
      },
      "PublicMemberSkillDto": {
        "required": [
          "name",
          "directoryFilterValue"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "directoryFilterValue": {
            "type": "string"
          }
        }
      },
      "PublicSkillFilterDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "key": {
            "type": "string",
            "format": "uuid"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "DevsApi"
    },
    {
      "name": "PublicHome"
    },
    {
      "name": "PublicMember"
    }
  ]
}