{
  "openapi": "3.1.1",
  "info": {
    "title": "SGF private member bridge",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:53625/"
    }
  ],
  "paths": {
    "/api/v1/member/register": {
      "post": {
        "tags": [
          "MemberRegistration"
        ],
        "operationId": "Member_Register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberRegistrationRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberRegistrationRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/MemberRegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberRegistrationResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberRegistrationResult"
                }
              },
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/MemberRegistrationResult"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberRegistrationResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberRegistrationResult"
                }
              },
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/MemberRegistrationResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/member/login": {
      "post": {
        "tags": [
          "MemberSession"
        ],
        "operationId": "Member_Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberLoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberLoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/MemberLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberLoginResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberLoginResult"
                }
              },
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/MemberLoginResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/member/session": {
      "get": {
        "tags": [
          "MemberSession"
        ],
        "operationId": "Member_Session",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberSessionDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberSessionDto"
                }
              },
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/MemberSessionDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/member/logout": {
      "post": {
        "tags": [
          "MemberSession"
        ],
        "operationId": "Member_Logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MemberLoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "rememberMe": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "MemberLoginResult": {
        "required": [
          "succeeded"
        ],
        "type": "object",
        "properties": {
          "succeeded": {
            "type": "boolean"
          }
        }
      },
      "MemberRegistrationRequest": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": [
              "null",
              "string"
            ]
          },
          "lastName": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "challengeQuestion": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MemberRegistrationResult": {
        "required": [
          "succeeded",
          "errors"
        ],
        "type": "object",
        "properties": {
          "succeeded": {
            "type": "boolean"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "MemberSessionDto": {
        "required": [
          "username",
          "name"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "MemberRegistration"
    },
    {
      "name": "MemberSession"
    }
  ]
}