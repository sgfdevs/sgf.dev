# Vite loads ignored .env files. Built Node does not: inject these at startup
# or use node --env-file=.env build. Never pass private values as Docker build args.
# Server-only. Used only when SvelteKit server code calls the CMS API.
CMS_INTERNAL_ORIGIN=http://127.0.0.1:5099

# Server-only native Delivery API key. Set privately to Umbraco__CMS__DeliveryApi__ApiKey.
# Required for content-page loads, even if the CMS permits public published-content access.
# CMS_DELIVERY_API_KEY=

# Member login is disabled until CMS_MEMBER_BRIDGE_SECRET is set privately and matches
# backend SGFDevs__MemberBridge__Secret. Never commit a secret here.
# CMS_MEMBER_BRIDGE_SECRET=
# Set backend SGFDevs__MemberBridge__FrontendOrigin=http://127.0.0.1:3000
# for reset-email links. This is not a browser CORS allowlist.
# CMS_MEMBER_COOKIE_NAME defaults to .AspNetCore.Identity.Application.

# Server-only. Set these only when testing fictional local media through the same-origin proxy.
# Do not point ordinary local development at production media.
# MEDIA_UPSTREAM_ORIGIN=http://127.0.0.1:5099
# MEDIA_UPSTREAM_PATH_PREFIX=/media/
# MEDIA_SOURCE_PUBLIC_ORIGIN=https://media.sgf.dev

# Adapter-node request cap: 8 MiB avatar plus multipart overhead.
BODY_SIZE_LIMIT=9M

# Public build input. Adapter-node 6 uses paths.origin, not runtime ORIGIN.
# Export ORIGIN in the build shell; setting it only in .env/startup has no effect.
# ORIGIN=http://127.0.0.1:3000
# HOST=127.0.0.1
# PORT=3000
# Leave proxy trust headers unset. Build for the external origin behind a proxy.

# Local schema refresh only. npm run api:schema:fetch reads the public OpenAPI doc from this origin.
SGF_CMS_SCHEMA_ORIGIN=http://127.0.0.1:5099
